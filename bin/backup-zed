#!/usr/bin/env zsh

set -e
set -u

MAC_STACK_ROOT=${0:A:h:h}
ZED_BACKUP="$MAC_STACK_ROOT/stack/zed"

mkdir -p "$ZED_BACKUP"
cp -f ~/.config/zed/settings.json "$ZED_BACKUP/settings.json"
cp -f ~/.config/zed/keymap.json "$ZED_BACKUP/keymap.json"

print "✅ Backed up Zed settings and keymap to:\n$ZED_BACKUP"
