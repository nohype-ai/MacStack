#!/usr/bin/env zsh

# This script updates (sets up) this Mac

# Prepare
set -e                                      # Exit on any error
set -u                                      # Treat unset variables as error
BINARY_PATH=${0:A:h}                        # Get binary (current-) path
typeset -x MAC_STACK_ROOT=${BINARY_PATH:h}  # Get repo root path
path=("$BINARY_PATH" $path)                 # Make commands in /bin available

# Function for printing help
print_help() {
    echo "Valid calls are:"
    echo "  mack update        → update (set up) this machine"
    echo "  mack update-repos  → clone/sync git repos as defined by your macstack.json file"
    echo "  mack brew-clip     → delete Homebrew packages that are not in your Mac Stack Brewfile, and clean up other stuff"
    echo "  mack brew-force    → [normally not needed] force apps in /Applications into Homebrew management if they are in your Mac Stack Brewfile"
    echo "  mack backup-zed    → copy Zed settings.json and keymap.json to stack/zed"
}

# Switch by sub command
case "${1:-}" in
    "" | "help" | "--help" | "-h")
        print_help
        ;;
    "update")
        # Set safe permissions for project directory
        echo "🔒 Setting safe permissions for project directory ..."
        chmod 700 "$MAC_STACK_ROOT" # Only owner can access project

        # General stack
        "$MAC_STACK_ROOT/symlinks to dotfiles/generate.sh"
        "$MAC_STACK_ROOT/scripts/zshrc/update.sh"
        "$MAC_STACK_ROOT/scripts/homebrew/update_mac_stack.sh"

        # Custom user stack
        source "$MAC_STACK_ROOT/scripts/stack_config/load.sh"
        "$MAC_STACK_ROOT/scripts/homebrew/update_user_stack.sh"
        "$MAC_STACK_ROOT/scripts/git/update_git_config.sh"
        "$MAC_STACK_ROOT/scripts/update_ide_settings.sh"
        "$MAC_STACK_ROOT/stack/update.sh"

        print "✅ Did update (set up) this Mac."
        print "💡 To get the new shell environment, relaunch your shell or run 'source ~/.zshrc'"
        ;;
    "update-repos")
        update-repos
        ;;
    "brew-clip")
        "$MAC_STACK_ROOT/scripts/homebrew/brew-clip.sh"
        ;;
    "brew-force")
        "$MAC_STACK_ROOT/scripts/homebrew/brew-force.sh"
        ;;
    "backup-zed")
        backup-zed
        ;;
    *)
        echo "🛑 Unknown command: <$1>"
        print_help
        exit 1
        ;;
esac
