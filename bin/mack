#!/usr/bin/env zsh

# This script updates (sets up) this Mac

# Prepare
set -e                                      # Exit on any error
set -u                                      # Treat unset variables as error
BINARY_PATH=${0:A:h}                        # Get binary (current-) path
typeset -x MAC_STACK_ROOT=${BINARY_PATH:h}  # Get repo root path

# Ensure Homebrew packages are immediately in PATH for this script and all scripts it calls — even when we just installed Homebrew for the first time
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Enable Homebrew on macOS pre-releases / betas
export HOMEBREW_DEVELOPER=1

# Get function to retrieve stack path from settings or user input
source "$MAC_STACK_ROOT/scripts/config/load_stack_path.sh"

# Function for printing help
print_help() {
    echo "Valid calls are:"
    echo "mack update        → update (set up) this machine, including git repos as defined in your stack"
    echo "mack update-repos  → update only the git repos: clone/sync as defined in your stack by macstack.json and git/repos_folder_template/"
    echo "mack brew-clip     → delete Homebrew packages that are not in your stack's Brewfile, and clean up other stuff"
    echo "mack brew-force    → [normally not needed] force apps in /Applications into Homebrew management if they are in your stack's Brewfile"
    echo "mack backup-zed    → backup Zed settings.json and keymap.json to zed/ in your stack"
    echo "mack shellenv      → print shell customizations for eval in ~/.zshrc"
    echo "mack config        → configure mack settings (e.g. stack folder path)"
}

# Switch by sub command
case "${1:-}" in
    "" | "help" | "--help" | "-h")
        print_help
        ;;
    "update")
        # Load path of active stack into STACK
        load_stack_path
        print "🍏 Stack: $STACK"

        # Set safe permissions for stack directory
        echo "🔒 Setting safe permissions for stack directory ..."
        chmod 700 "$STACK" # Only owner can access stack

        # Update zshrc entry
        "$MAC_STACK_ROOT/scripts/zshrc/update.sh"

        # Update Homebrew
        print "🍺 Updating Homebrew ..."
        if ! output=$(brew update 2>&1); then
            echo "$output"
            echo "⚠️ Homebrew update failed, but let's try to continue ..."
        fi

        # Custom user stack
        source "$MAC_STACK_ROOT/scripts/stack_config/load.sh"
        "$MAC_STACK_ROOT/scripts/homebrew/update_user_stack.sh"
        "$MAC_STACK_ROOT/scripts/git/update_git_config.sh"
        "$MAC_STACK_ROOT/scripts/update_ide_settings.sh"

        if [[ ! -f "$STACK/update.sh" ]]; then
            print "⚠️  Warning: Skipping custom install step since script does not exist in stack:\n$STACK/update.sh"
        else
            "$STACK/update.sh"
        fi

        "$MAC_STACK_ROOT/scripts/update_ai_agent_settings.sh"
        "$MAC_STACK_ROOT/scripts/update-repos.sh"

        print "✅ Did update (set up) this Mac."
        print "💡 Best relaunch your shell or run 'source ~/.zshrc'"
        ;;
    "update-repos")
        load_stack_path
        source "$MAC_STACK_ROOT/scripts/stack_config/load.sh"
        "$MAC_STACK_ROOT/scripts/update-repos.sh"
        ;;
    "brew-clip")
        load_stack_path
        "$MAC_STACK_ROOT/scripts/homebrew/brew-clip.sh"
        ;;
    "brew-force")
        load_stack_path
        "$MAC_STACK_ROOT/scripts/homebrew/brew-force.sh"
        ;;
    "backup-zed")
        load_stack_path
        "$MAC_STACK_ROOT/bin/backup-zed"
        ;;
    "shellenv")
        cat "$MAC_STACK_ROOT/scripts/zshrc/content_macstack.sh"
        cat "$MAC_STACK_ROOT/scripts/zshrc/content_stack.sh"
        ;;
    "config")
        load_stack_path --prompt
        echo "Selected stack: $STACK"
        ;;
    *)
        echo "🛑 Unknown command: <$1>"
        print_help
        exit 1
        ;;
esac
