#!/usr/bin/env zsh

# Run a command silently, only showing its output if it fails
silent() {
    local output_file=$(mktemp)

    # Run the command (passed as arguments), redirecting both stdout and stderr
    if "$@" > "$output_file" 2>&1; then
        rm "$output_file"
        return 0
    else
        local exit_code=$?
        echo "❌ Command failed: $*"
        cat "$output_file"
        rm "$output_file"
        return $exit_code
    fi
}
