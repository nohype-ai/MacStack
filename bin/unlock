#!/usr/bin/env zsh
# unlock - Decrypt files in working directory (secure password input)

# Ensure transcrypt is installed
if ! command -v transcrypt &>/dev/null; then
    echo "❌ Error: transcrypt is not installed."
    exit 1
fi

local repo_dir="$PWD"

# Ensure we're in a git repo
if ! git -C "$repo_dir" rev-parse --is-inside-work-tree &>/dev/null; then
    echo "❌ Error: Not inside a git repository."
    exit 1
fi

# Ensure transcrypt is used in this repo
if ! transcrypt --list &>/dev/null; then
    echo "❌ Error: This repository does not use transcrypt."
    exit 1
fi

# Ensure repo is clean
if ! git -C "$repo_dir" diff --quiet || ! git -C "$repo_dir" diff --cached --quiet; then
    echo "❌ Error: Repository has uncommitted changes."
    echo "   Please commit or stash your changes before unlocking."
    exit 1
fi

# Read password
echo -n "Enter transcrypt password: "
read -s password
echo   # new line after hidden input

if [[ -z "$password" ]]; then
    echo "❌ Error: No password entered."
    exit 1
fi

# Decrypt files
echo "🔓 Unlocking repository..."
if transcrypt -c aes-256-cbc -p "$password"; then
    echo "✅ Working directory now shows decrypted content."
else
    echo "❌ Failed to unlock the repository."
    exit 1
fi
