{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["git", "repos", "flags"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "git": {
      "type": "object",
      "required": ["user_name", "user_email", "core_editor"],
      "additionalProperties": false,
      "properties": {
        "user_name": { "type": "string", "minLength": 1 },
        "user_email": { "type": "string", "format": "email" },
        "core_editor": { "type": "string", "minLength": 1 }
      }
    },
    "repos": {
      "type": "object",
      "required": ["folder"],
      "additionalProperties": false,
      "properties": {
        "folder": { "type": "string", "minLength": 1 }
      }
    },
    "flags": {
      "type": "object",
      "required": ["skip_brew_updates"],
      "additionalProperties": false,
      "properties": {
        "skip_brew_updates": { "type": "boolean" }
      }
    }
  }
}
